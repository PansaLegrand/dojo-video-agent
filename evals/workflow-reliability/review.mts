const root=path.resolve(process.argv[process.argv.indexOf('--output')+1]??'');if(!process.argv.includes('--live')||!process.argv.includes('--output'))throw Error('Usage: node --import tsx evals/workflow-reliability/review.mts --live --output CAMPAIGN');
