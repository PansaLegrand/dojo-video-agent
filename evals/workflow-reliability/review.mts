 const expected=12,passed=campaign.ledger.trials.filter((t:any)=>t.cohort===cohort&&t.qualification==='passed');await fs.writeFile(path.join(root,'qualification-summary-'+cohort+'.json'),JSON.stringify({version:'workflow-v1',cohort,expected,passed:passed.length,qualified:passed.length===expected,requests:campaign.budget.requests.length,accountedUsd:campaign.budget.accountedUsd,trials:campaign.ledger.trials.map((t:any)=>({caseId:t.caseId,status:t.status,qualification:t.qualification,turns:t.turns?.map((v:any)=>({turn:v.turn,status:v.status,semantic:v.grade?.passed,visual:v.independentReview?.passed}))})),limits:'Two varied repetitions in each of two editing hosts. Existing corpus is reused, not unseen. Actual-model core/staged editing with owned fixture adapters; real browser export and automated normal-speed playback. No production/auth/billing rollout or human preference claim.'},null,2));
