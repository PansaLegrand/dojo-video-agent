const agent=process.cwd(),web=path.resolve('../dojo-video-web'),sources=[await captureCreativeSource(agent,'open-source'),await captureCreativeSource(web,'commercial-web')];assert(sources.every(s=>!s.dirty),'Commit the reviewed candidate first');
