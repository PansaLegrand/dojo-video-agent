     assert.equal(args.projectId,id,'Tools are scoped to this trial project');if(name==='openmotion_open_preview'&&['record_display','record_review'].includes(args.action))throw Error('Only host-observed display/review evidence may be recorded');
     const result=await client.callTool({name,arguments:args});if(result.isError)return result;let value=decode(result);
     if(name==='dojo_review_edit'&&value.reviewId)lastReview=value;
     if(name==='dojo_request_preview'&&value.requestRef){const card=page.locator(`[data-output-request-id="${value.requestRef.id}"]`);await card.waitFor({timeout:60000});await card.getByRole('checkbox').check();await card.getByRole('button',{name:'Send preview frames',exact:true}).click();await card.getByText('Preview frames saved for review',{exact:true}).waitFor({timeout:90000});return client.callTool({name:'dojo_read_preview',arguments:{projectId:id,reviewId:args.reviewId,requestId:value.requestRef.id}})}
     if(name==='dojo_request_export'){exportIntent={reviewId:args.reviewId,requestId:value.value?.projectExport?.requestRef?.id??value.projectExport?.requestRef?.id};if(applied&&exportIntent.requestId)latestExport=await dojoOutput(page,id,exportIntent.requestId,await exportDir())}
     if(name==='dojo_apply_edit'){applied=true;if(exportIntent?.requestId)latestExport=await dojoOutput(page,id,exportIntent.requestId,await exportDir())}
     if(name==='openmotion_open_preview'&&value.previewUrl){await page.goto(value.previewUrl);await page.screenshot({path:path.join(td,'studio-inspection.png'),fullPage:true})}
     if(name==='openmotion_export_request'&&value.job){const jobId=value.job.id;const final=await until(async()=>{const v=decode(await client.callTool({name:'openmotion_get_project',arguments:{projectId:id,exportJobId:jobId}}));return ['completed','failed','cancelled'].includes(v.exportJob?.state)?v.exportJob:null},900000);await fs.writeFile(path.join(td,`export-${jobId}.json`),JSON.stringify(final,null,2));if(final.state==='completed'){const ed=await exportDir(),local=path.join(ed,'output.mp4');await fs.copyFile(final.path,local);latestExport=await verifyExport(local,ed)}return {content:[{type:'text',text:JSON.stringify({original:value,completed:final})}]}}
     return result;
    };
    if(!live){turn.status='dry-ready';turn.inventory=specs.map((s:any)=>s.name);const inspected=await call(kind==='dojo'?'dojo_inspect_project':'openmotion_get_project',{projectId:id,...(kind==='dojo'?{args:{}}:{})});await fs.writeFile(path.join(td,'dry-inspection.json'),JSON.stringify(inspected,null,2));await campaign.persist();break}
    let outputTokens=recovery==='speech'?priorOutputTokens:0;for(let step=0;step<stepLimit;step++){
     if(outputTokens>=24000)break;const reply=await campaign.model.complete(messages,specs,AbortSignal.timeout(600000),{maxOutputTokens:Math.min(8192,24000-outputTokens)});outputTokens+=reply.usage?.outputTokens??0;messages.push({role:'assistant',content:reply.text,tool_calls:reply.calls.map((c:any)=>({id:c.id,type:'function',function:{name:c.name,arguments:c.arguments}})),...(reply.providerOutput?{providerOutput:reply.providerOutput}:{})});
     if(!reply.calls.length){turn.summary=reply.text;break}
     for(const [callIndex,c] of reply.calls.entries()){let result:any;const record:any={name:c.name,args:JSON.parse(c.arguments)};turn.tools.push(record);try{if(callIndex>=8)throw Error('At most eight tools per response; this call was not executed');if(!specs.some((s:any)=>s.name===c.name))throw Error('Tool is not admitted');result=await call(c.name,record.args);record.error=result.isError??false}catch(e){result={isError:true,content:[{type:'text',text:String(e)}]};record.error=String(e)}
      const images=result.content?.filter((x:any)=>x.type==='image')??[];const texts=result.content?.filter((x:any)=>x.type!=='image')??result;record.response=JSON.parse(JSON.stringify(texts));messages.push({role:'tool',tool_call_id:c.id,content:JSON.stringify({isError:!!result.isError,result:texts})});if(images.length)messages.push({role:'user',content:[{type:'text',text:'Authorized saved visual evidence from '+c.name+'. Inspect these actual pixels.'},...images.map((i:any)=>({type:'image_url',image_url:{url:`data:${i.mimeType};base64,${i.data}`}}))]});await campaign.persist();
     }
    }
    const state=kind==='dojo'?await api(`/api/projects/${id}/document`):decode(await client.callTool({name:'openmotion_get_project',arguments:{projectId:id}}));await fs.writeFile(path.join(td,'after.json'),JSON.stringify(state,null,2));
    if(kind==='openmotion'){const sourceFiles:any[]=[];for(const f of state.project?.files??[]){if(!/\.(html|css|json)$/.test(f.path))continue;const r=decode(await client.callTool({name:'openmotion_get_project',arguments:{projectId:id,file:{path:f.path}}}));sourceFiles.push({path:f.path,read:r})}await fs.writeFile(path.join(td,'source-files.json'),JSON.stringify(sourceFiles,null,2))}
    await fs.writeFile(path.join(td,'conversation.json'),JSON.stringify(messages.map(({providerOutput,...m}:any)=>m),null,2));turn.export=latestExport?{file:latestExport.file,sha256:latestExport.sha256,duration:latestExport.duration}:null;turn.modelCalls=campaign.budget.requests.length-turn.startRequest;turn.status=latestExport?'exported-awaiting-independent-review':'incomplete';turn.finishedAt=new Date().toISOString();history.push({instruction,summary:turn.summary??turn.status});previousMessages=messages.slice(1).map(m=>m.role==='user'&&Array.isArray(m.content)&&!m.content[0]?.text?.startsWith('Pinned native visual references')?{...m,content:m.content.filter((p:any)=>p.type==='text')} : m);await campaign.persist();console.log(JSON.stringify({caseId,turn:turn.number,status:turn.status,requests:campaign.budget.requests.length,usd:campaign.budget.accountedUsd}));
    if(!latestExport)break;
   }
   trial.status=live?(recovery?(trial.turns.length===instructions.length&&trial.turns.every((t:any)=>t.export)?'recovered-followups-exported-awaiting-review':'recovery-followups-incomplete'):(trial.turns.filter((t:any)=>!t.supplement).length===journey.turns.length&&trial.turns.filter((t:any)=>!t.supplement).every((t:any)=>t.export)?'exported-awaiting-independent-review':'incomplete')):'dry-ready';
  }catch(e){trial.status='failed';trial.error=String(e);console.log(JSON.stringify({caseId,error:String(e)}));if(String(e).includes('budget exhausted')||String(e).includes('Three independent provider failures')||String(e).includes('Candidate source changed'))throw e}finally{await page?.close();await campaign.persist()}
  if(!live&&campaign.ledger.trials.filter((t:any)=>t.caseId).length>=2)break;
 }
}finally{await dojo?.close();await openmotion?.close();for(const tr of transports)await tr.close();await browser?.close();child.kill('SIGTERM');await log.close();await campaign.close()}
