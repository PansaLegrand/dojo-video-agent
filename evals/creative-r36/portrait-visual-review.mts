import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {openCampaign} from './campaign-continuation.ts';
const root=path.resolve('test-results/r36-campaign/live'),out=path.join(root,'portrait-syntax-recovery'),frames=[120,210,299],files=frames.map(f=>path.join(out,`frame-${f}.jpg`)),campaign=await openCampaign(root,[import.meta.filename,...files,path.join(out,'geometry.json')],true);campaign.setContext({host:'dojo',scenario:'R34-portrait-pixel-review',repetition:1,turn:4});
