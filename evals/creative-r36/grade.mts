import fs from 'node:fs/promises';import path from 'node:path';
/** Frozen outcome checks; these do not score beauty or treat source strings as rendered proof. */
export function technicalChecks(probe:any,journey:string,turn:number,supplement=false){const v=probe.streams.find((s:any)=>s.codec_type==='video'),a=probe.streams.find((s:any)=>s.codec_type==='audio'),portrait=journey==='J1'&&turn>=3||supplement&&turn===2;const duration=Number(probe.format.duration),target=journey==='J1'?10:journey==='J2'?(supplement?10:8):journey==='J3'?12:null;return {dimensions:v?.width===(portrait?540:960)&&v?.height===(portrait?960:540),fps:v?.avg_frame_rate==='30/1',duration:target===null?duration>15&&duration<24:Math.abs(duration-target)<.1,audio:journey==='J4'?!!a:!a}}
export const rubric={version:'r36-v1',visual:[{name:'hierarchy',question:'Is the main idea clear without reading everything?'},{name:'readability',question:'Is required copy legible, unclipped and held long enough?'},{name:'composition',question:'Do spacing, alignment, contrast and framing feel intentional?'},{name:'motion',question:'Does movement explain the story or relationships, with controlled pacing?'},{name:'continuity',question:'Do states and transitions connect without accidental jumps?'},{name:'ending',question:'Does the ending settle with a readable identity and URL where requested?'}],rating:'Each criterion: 0 missing/broken, 1 weak, 2 usable, 3 polished. Report criterion evidence and limitations; no aggregate is an objective aesthetic measurement.',semantic:{J1:['Problem, product, three workflow proof, supplied logo/URL. No unsupported product claims.','Only headline changes; other story/copy/timing preserved.','Portrait recomposition preserves facts and prior headline.','Only final two seconds change; compare first eight seconds of consecutive exports.'],J2:['Bar and line both represent 12,18,31,24 thousand correctly; readable W labels.','Manual Week one and mint retained; W3=31 peak, slower entrance, same eight-second duration.'],J3:['Capture/Organize/Share supplied images, perspective card and motivated cursor actions; concept label.','Only step-two caption changes; other text, timing and actions preserved.'],J4:['Original source picture/audio, source-clock uh cuts with closed gaps, remaining speech intact.','Genuine English and Spanish facts aligned per cue; phrase-bound Andrew Ng callout; no new paid media.']}};
if(process.argv.includes('--report')){const root=path.resolve('test-results/r36-campaign/live'),ledger=JSON.parse(await fs.readFile(path.join(root,'ledger.json'),'utf8')),rows=[];for(const trial of ledger.trials.filter((t:any)=>t.caseId))for(const turn of trial.turns){if(!turn.export)continue;const probe=JSON.parse(await fs.readFile(path.join(path.dirname(turn.export.file),'probe.json'),'utf8'));rows.push({caseId:trial.caseId,turn:turn.number,checks:technicalChecks(probe,trial.journey,turn.number),semanticReview:'pending',visualReview:'pending'})}await fs.writeFile(path.join(root,'technical-grades.json'),JSON.stringify({rubric,rows},null,2));console.log(JSON.stringify(rows))}
